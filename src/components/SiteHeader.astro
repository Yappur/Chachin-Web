<header class="site-header" data-site-header>
	<div class="site-header__inner page-container">
		<a class="site-header__brand" href="#inicio" aria-label="Chachín, inicio">
			<img src="/Logo_Chachin.png" alt="Chachín" width="512" height="512" />
		</a>

		<nav class="site-header__nav" aria-label="Navegación principal">
			<a href="#sabores">La propuesta</a>
			<a href="#pizzas">Pizzas</a>
			<a href="#visitanos">Encontranos</a>
		</nav>

		<a class="site-header__action" href="#visitanos">Venite a conocer <span aria-hidden="true">↗</span></a>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	if (header) {
		const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>

