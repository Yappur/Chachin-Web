---
import PizzaCascade from './PizzaCascade.astro';
import pizza01 from '../assets/foods/pizza-01.webp';
import pizza02 from '../assets/foods/pizza-02.webp';

const heroPizzas = [
	{ src: pizza01, alt: 'Pizza con mozzarella, tomate y albahaca' },
	{ src: pizza02 },
];
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
	<div class="hero__glow" aria-hidden="true"></div>
	<div class="hero__layout page-container">
		<div class="hero__copy">
			<p class="hero__eyebrow">Nueva casa en Concepción, Tucumán</p>
			<h1 id="hero-title">La mesa<br />está <em>lista.</em></h1>
			<p class="hero__intro">
				Chachín tiene casa nueva para compartir comida rica y buenos momentos.
			</p>
			<a class="hero__button" href="#sabores">Conocé la propuesta <span aria-hidden="true">↘</span></a>
		</div>

		<div class="hero__visual">
			<PizzaCascade
				items={heroPizzas}
				steps={[{ angle: 27, spacing: 0.62, shrink: 0.68 }]}
				trigger="load"
				sizes="(max-width: 850px) 80vw, 42vw"
				priority
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: min(740px, calc(100svh - 92px));
		overflow: hidden;
		isolation: isolate;
		/* Degradado tranquilo: arriba empata con el header naranja y se calienta hacia abajo */
		background:
			linear-gradient(180deg, var(--color-orange) 0%, rgb(239 106 46 / 0%) 18%),
			radial-gradient(120% 90% at 78% 48%, #f58a4e 0%, rgb(245 138 78 / 0%) 58%),
			radial-gradient(90% 80% at 0% 100%, #d9541f 0%, rgb(217 84 31 / 0%) 62%),
			linear-gradient(180deg, var(--color-orange) 0%, #ec6429 55%, #e15a22 100%);
		color: var(--color-ink);
	}

	/* Halo suave detrás de las pizzas que "respira" muy lento */
	.hero__glow {
		position: absolute;
		z-index: -1;
		top: 50%;
		right: 6%;
		width: min(62vw, 820px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, rgb(255 196 140 / 55%) 0%, rgb(255 170 110 / 22%) 38%, rgb(255 170 110 / 0%) 70%);
		transform: translateY(-50%);
		animation: hero-breathe 14s ease-in-out infinite alternate;
		pointer-events: none;
	}

	@keyframes hero-breathe {
		from { opacity: 0.75; transform: translateY(-50%) scale(0.96); }
		to { opacity: 1; transform: translateY(-50%) scale(1.04); }
	}

	.hero__layout {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		align-items: center;
		padding-top: 0.5rem;
		padding-bottom: clamp(3.5rem, 7vh, 5.5rem);
	}

	.hero__copy {
		position: relative;
		z-index: 1;
		padding-block: 2.5rem 1rem;
	}

	.hero__eyebrow {
		margin-bottom: clamp(1.25rem, 2.5vw, 2.25rem);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 8.5ch;
		font-family: var(--font-display);
		font-size: var(--text-display);
		letter-spacing: -0.035em;
		line-height: 0.9;
	}

	.hero h1 em {
		font-family: var(--font-editorial);
		font-size: 0.98em;
		font-weight: 400;
		letter-spacing: -0.045em;
	}

	.hero__intro {
		max-width: 34ch;
		margin-top: clamp(1.5rem, 2.8vw, 2.25rem);
		font-size: var(--text-lead);
		line-height: 1.4;
	}

	.hero__button {
		min-height: 50px;
		display: inline-flex;
		align-items: center;
		gap: 20px;
		margin-top: 1.5rem;
		padding: 0 18px;
		background: var(--color-ink);
		color: var(--color-cream);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 180ms var(--ease-standard), color 180ms var(--ease-standard), transform 300ms var(--ease-standard);
	}

	.hero__button:hover {
		background: var(--color-cream);
		color: var(--color-ink);
		transform: translateY(-2px);
	}

	.hero__button span {
		font-size: 1.1rem;
	}

	/* Cascada dominó: ver PizzaCascade.astro */
	.hero__visual {
		position: relative;
		width: 100%;
		max-width: 760px;
		justify-self: end;
		padding-block: 1.5rem;
	}

	@media (max-width: 850px) {
		.hero {
			min-height: 0;
		}

		.hero__layout {
			grid-template-columns: 1fr;
			padding-top: 1.25rem;
			padding-bottom: 3.75rem;
		}

		.hero__copy {
			max-width: 650px;
			padding-block: 1rem 0;
		}

		.hero h1 {
			font-size: clamp(5rem, 13vw, 7.5rem);
		}

		.hero__visual {
			width: min(100%, 620px);
			justify-self: center;
			padding-block: 1rem 0;
		}

		.hero__glow {
			top: auto;
			bottom: -10%;
			right: -10%;
			width: 110vw;
			transform: none;
			animation: none;
		}
	}

	@media (max-width: 520px) {
		.hero__layout {
			padding-top: 0.5rem;
			padding-bottom: 2.75rem;
		}

		.hero__eyebrow {
			max-width: 260px;
			margin-bottom: 1rem;
			font-size: 0.8125rem;
		}

		.hero h1 {
			font-size: clamp(4.25rem, 18vw, 5.5rem);
			line-height: 0.9;
		}

		.hero__intro {
			max-width: 31ch;
			margin-top: 1.25rem;
			font-size: 1.0625rem;
		}

		.hero__button {
			min-height: 48px;
			margin-top: 1.25rem;
		}

	}
</style>
