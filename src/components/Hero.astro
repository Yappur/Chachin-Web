---
import SiteHeader from './SiteHeader.astro';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
	<SiteHeader />

	<div class="hero__layout page-container">
		<div class="hero__copy">
			<p class="hero__eyebrow">Nueva casa en Concepción, Tucumán</p>
			<h1 id="hero-title">La mesa<br />está <em>lista.</em></h1>
			<p class="hero__intro">
				Chachín tiene casa nueva para compartir comida rica y buenos momentos.
			</p>
			<a class="hero__button" href="#sabores">Conocé la propuesta <span aria-hidden="true">↘</span></a>
			<p class="hero__aside">Hecho para compartir</p>
		</div>

		<figure class="hero__visual" aria-label="Pizzas de Chachín para compartir">
			<img
				class="hero__pizza hero__pizza--main"
				src="/foods/pizza-01.webp"
				alt="Pizza con mozzarella, tomate y albahaca"
				width="1024"
				height="1024"
				fetchpriority="high"
			/>
			<img
				class="hero__pizza hero__pizza--second"
				src="/foods/pizza-02.webp"
				alt="Pizza de mozzarella y albahaca"
				width="1024"
				height="1024"
			/>
		</figure>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: min(830px, 100svh);
		overflow: hidden;
		background: var(--color-orange);
		color: var(--color-ink);
	}

	.hero__layout {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		align-items: center;
		padding-top: 0.5rem;
		padding-bottom: clamp(3.5rem, 7vh, 5.5rem);
	}

	.hero__copy {
		position: relative;
		z-index: 1;
		padding-block: 2.5rem 1rem;
	}

	.hero__eyebrow {
		margin-bottom: clamp(1.25rem, 2.5vw, 2.25rem);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 8.5ch;
		font-family: var(--font-display);
		font-size: var(--text-display);
		letter-spacing: -0.035em;
		line-height: 0.9;
	}

	.hero h1 em {
		font-family: var(--font-editorial);
		font-size: 0.98em;
		font-weight: 400;
		letter-spacing: -0.045em;
	}

	.hero__intro {
		max-width: 34ch;
		margin-top: clamp(1.5rem, 2.8vw, 2.25rem);
		font-size: var(--text-lead);
		line-height: 1.4;
	}

	.hero__button {
		min-height: 50px;
		display: inline-flex;
		align-items: center;
		gap: 20px;
		margin-top: 1.5rem;
		padding: 0 18px;
		background: var(--color-ink);
		color: var(--color-cream);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 180ms var(--ease-standard), color 180ms var(--ease-standard), transform 300ms var(--ease-standard);
	}

	.hero__button:hover {
		background: var(--color-cream);
		color: var(--color-ink);
		transform: translateY(-2px);
	}

	.hero__button span {
		font-size: 1.1rem;
	}

	.hero__aside {
		margin: 1.75rem 0 0 2rem;
		font-family: var(--font-editorial);
		font-size: clamp(1.4rem, 2.4vw, 2rem);
		font-style: italic;
	}

	.hero__visual {
		position: relative;
		width: 100%;
		min-height: clamp(400px, 47vw, 650px);
		display: grid;
		place-items: center;
	}

	.hero__pizza {
		filter: drop-shadow(0 22px 24px rgb(37 37 37 / 14%));
	}

	.hero__pizza--main {
		width: min(100%, 620px);
		margin-left: auto;
		transform: rotate(3deg);
	}

	.hero__pizza--second {
		position: absolute;
		bottom: 4%;
		left: 0;
		width: clamp(150px, 27%, 260px);
		transform: rotate(-10deg);
	}

	@media (max-width: 850px) {
		.hero {
			min-height: 0;
		}

		.hero__layout {
			grid-template-columns: 1fr;
			padding-top: 1.25rem;
			padding-bottom: 3.75rem;
		}

		.hero__copy {
			max-width: 650px;
			padding-block: 1rem 0;
		}

		.hero h1 {
			font-size: clamp(5rem, 13vw, 7.5rem);
		}

		.hero__visual {
			width: min(100%, 720px);
			min-height: clamp(340px, 70vw, 560px);
			margin: 0 auto;
		}

		.hero__pizza--main {
			width: min(82%, 530px);
			margin-left: 10%;
		}

		.hero__pizza--second {
			left: 5%;
			width: clamp(140px, 28%, 220px);
		}
	}

	@media (max-width: 520px) {
		.hero__layout {
			padding-top: 0.5rem;
			padding-bottom: 2.75rem;
		}

		.hero__eyebrow {
			max-width: 260px;
			margin-bottom: 1rem;
			font-size: 0.8125rem;
		}

		.hero h1 {
			font-size: clamp(4.25rem, 18vw, 5.5rem);
			line-height: 0.9;
		}

		.hero__intro {
			max-width: 31ch;
			margin-top: 1.25rem;
			font-size: 1.0625rem;
		}

		.hero__button {
			min-height: 48px;
			margin-top: 1.25rem;
		}

		.hero__aside {
			margin: 1.25rem 0 0 1rem;
			font-size: 1.375rem;
		}

		.hero__visual {
			min-height: 80vw;
			max-height: 390px;
		}

		.hero__pizza--main {
			width: 88%;
			margin-left: 8%;
		}

		.hero__pizza--second {
			bottom: 1%;
			left: -1%;
			width: 34%;
		}
	}
</style>
