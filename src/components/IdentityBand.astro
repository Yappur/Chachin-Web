---
const phrases = [
	'Buenos momentos',
	'Comida rica',
	'Amigos y familia',
	'Sabores únicos',
	'Risas compartidas',
	'Buena compañía',
	'Momentos inolvidables',
	'Hecho con amor',
	'Encuentros especiales',
	'Sentirse como en casa',
];
---

<section class="identity-band" aria-label="La esencia de Chachín">
	<!-- Lista completa y estática para lectores de pantalla -->
	<ul class="sr-only">
		{phrases.map((phrase) => <li>{phrase}</li>)}
	</ul>

	<div class="identity-band__viewport" aria-hidden="true">
		<div class="identity-band__track">
			{[0, 1].map(() => (
				<ul class="identity-band__group">
					{phrases.map((phrase, i) => (
						<li class:list={['identity-band__item', { 'identity-band__item--serif': i % 2 === 1 }]}>
							<span>{phrase}</span>
							<span class="identity-band__star">✳</span>
						</li>
					))}
				</ul>
			))}
		</div>
	</div>
</section>

<style>
	.identity-band {
		position: relative;
		z-index: 1;
		background: var(--color-cream);
		color: var(--color-ink);
		border-block: 1px solid rgb(37 37 37 / 10%);
	}

	.identity-band__viewport {
		overflow: hidden;
		/* Desvanece los bordes para que el carrusel entre y salga suave */
		mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
	}

	.identity-band__track {
		display: flex;
		width: max-content;
		animation: identity-scroll 48s linear infinite;
	}

	.identity-band__viewport:hover .identity-band__track {
		animation-play-state: paused;
	}

	.identity-band__group {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.identity-band__item {
		min-height: 92px;
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 2.4vw, 2.25rem);
		padding-right: clamp(1.25rem, 2.4vw, 2.25rem);
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.8vw, 2.5rem);
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.identity-band__item--serif {
		font-family: var(--font-editorial);
		font-size: clamp(1.75rem, 3.2vw, 2.9rem);
		font-style: italic;
		text-transform: none;
		letter-spacing: -0.02em;
	}

	.identity-band__star {
		color: var(--color-orange);
		font-family: var(--font-body);
		font-size: 0.55em;
		font-style: normal;
	}

	@keyframes identity-scroll {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@media (max-width: 700px) {
		.identity-band__item {
			min-height: 68px;
			font-size: 1.375rem;
		}

		.identity-band__item--serif {
			font-size: 1.6rem;
		}

		.identity-band__track {
			animation-duration: 36s;
		}
	}

	/* Sin movimiento: las frases quedan visibles en líneas que refluyen */
	@media (prefers-reduced-motion: reduce) {
		.identity-band__viewport {
			mask-image: none;
		}

		.identity-band__track {
			width: auto;
			animation: none;
			padding: 1rem var(--page-gutter);
		}

		.identity-band__group {
			flex-wrap: wrap;
			justify-content: center;
			row-gap: 0.5rem;
		}

		.identity-band__group + .identity-band__group {
			display: none;
		}

		.identity-band__item {
			min-height: 0;
		}
	}
</style>
