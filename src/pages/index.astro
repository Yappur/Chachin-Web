---
import FoodSection from '../components/FoodSection.astro';
import Hero from '../components/Hero.astro';
import IdentityBand from '../components/IdentityBand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StorySection from '../components/StorySection.astro';
import VisitSection from '../components/VisitSection.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Chachín | Comida rica y buenos momentos en Concepción"
	description="Chachín, bar-restaurante en Concepción, Tucumán. Una casa nueva para compartir comida rica y buenos momentos."
>
	<main>
		<Hero />
		<IdentityBand />
		<FoodSection />
		<StorySection />
		<VisitSection />
	</main>
	<SiteFooter />
</Layout>
